{
  "name": "purple-mc-panel",
  "version": "1.1.0",
  "description": "Self-hosted web control panel for Minecraft (Paper) servers — TypeScript backend, React frontend.",
  "main": "app.js",
  "private": true,
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "start": "node app.js",
    "dev": "tsx watch src/index.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.json",
    "build:client": "vite build --config client/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit",
    "check": "npm run typecheck",
    "test": "vitest run"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/express": "^4.17.23",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "axios": "^1.16.1",
    "express": "^4.22.2",
    "multer": "^2.1.1",
    "pidusage": "^4.0.1",
    "socket.io": "^4.8.3",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "lucide-react": "^0.550.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.6.0",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.20.0",
    "vitest": "^4.0.0"
  }
}
